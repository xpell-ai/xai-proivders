{
  "name": "@xpell/xai-providers",
  "version": "2.0.8",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./azure": {
      "import": "./dist/azure/index.js",
      "types": "./dist/azure/index.d.ts"
    },
    "./aime": {
      "import": "./dist/aime/index.js",
      "types": "./dist/aime/index.d.ts"
    },
    "./mock": {
      "import": "./dist/mock/index.js",
      "types": "./dist/mock/index.d.ts"
    },
    "./openai": {
      "import": "./dist/openai/index.js",
      "types": "./dist/openai/index.d.ts"
    },
    "./gemini": {
      "import": "./dist/gemini/index.js",
      "types": "./dist/gemini/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@xpell/node": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpell-ai/xai-proivders.git"
  }
